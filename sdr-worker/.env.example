# ─────────────────────────────────────────────────────────────
# uPixel — SDR Worker (POC) — variáveis de ambiente
# Copie para `.env` na VPS e preencha. NUNCA commitar o .env real.
# ─────────────────────────────────────────────────────────────

# Supabase (mesmo projeto do uPixel). A service role key é necessária para
# ler/atualizar a fila e ler conversas/integrações ignorando RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM compatível com a API OpenAI (/chat/completions). Ex.: OpenAI, NVIDIA NIM,
# Groq, OpenRouter, vLLM local, etc. Informe a base SEM o sufixo /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gpt-4o-mini

# ─── Ajustes opcionais do worker ─────────────────────────────
# Intervalo entre ciclos de polling (ms). Default: 5000
SDR_POLL_INTERVAL_MS=5000
# Quantas mensagens processar por ciclo. Default: 5
SDR_BATCH_SIZE=5
# Tentativas antes de marcar 'failed'. Default: 5
SDR_MAX_ATTEMPTS=5
# Quantas mensagens anteriores da conversa enviar como contexto ao LLM. Default: 10
SDR_HISTORY_LIMIT=10
# Temperatura do LLM. Default: 0.5
SDR_LLM_TEMPERATURE=0.5

# Prompt de sistema do SDR. Se vazio, usa o default embutido (pt-BR).
SDR_SYSTEM_PROMPT=
