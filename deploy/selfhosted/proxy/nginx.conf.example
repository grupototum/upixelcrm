# ════════════════════════════════════════════════════════════════════════
# nginx.conf.example — alternativa ao Caddyfile.example para quem já roda
# nginx na VPS (o repo já usa nginx em `deploy/nginx.conf` para o front —
# este arquivo é só para a API Supabase self-hosted, gateway separado).
#
# [OPERADOR]:
#   1. TLS via certbot: `certbot --nginx -d api.upixel.com.br` depois de
#      colocar este server block em /etc/nginx/sites-available/ (ou
#      conf.d/) e symlink em sites-enabled/ — certbot reescreve o bloco
#      para adicionar os `listen 443 ssl` automaticamente.
#   2. Kong escuta em KONG_HTTP_PORT (default 8000) no host da VPS.
# ════════════════════════════════════════════════════════════════════════

server {
    listen 80;
    server_name api.upixel.com.br;

    client_max_body_size 60M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Realtime usa WebSocket — timeouts mais longos que o default.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# Studio — restrito (auth básica ou IP allowlist). Gerar senha com:
#   sudo apt install apache2-utils && htpasswd -c /etc/nginx/.htpasswd admin
server {
    listen 80;
    server_name studio.upixel.com.br;

    location / {
        auth_basic "uPixel Studio";
        auth_basic_user_file /etc/nginx/.htpasswd;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
    }
}
