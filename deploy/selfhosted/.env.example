# ════════════════════════════════════════════════════════════════════════
# .env.example — Stack Supabase self-hosted do uPixel CRM (deploy/selfhosted/)
#
# [OPERADOR]: cp .env.example .env  →  preencher TODOS os valores abaixo.
# NENHUM valor real deve ir para o git — este arquivo é só o molde
# (nomes + instruções), sem preencher. O `.env` real fica só na VPS.
#
# IMPORTANTE: os valores aqui são NOVOS, gerados para a VPS — não são os
# mesmos do projeto cloud `xusdhzwfkzufupjwbebt`. O service role key do
# cloud NÃO funciona contra este Postgres self-hosted (é outro banco, outro
# JWT_SECRET). Ver Fase 4 do plano em ../../docs/MIGRACAO_SELFHOSTED_PLAN.md.
# ════════════════════════════════════════════════════════════════════════

# ─── Postgres ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ─── JWT / chaves da stack (GERAR, não usar as do cloud) ───────────────
# Passo a passo:
#   1. JWT_SECRET: qualquer string aleatória forte (≥ 40 chars).
#        openssl rand -base64 42
#   2. ANON_KEY e SERVICE_ROLE_KEY: JWTs assinados com o JWT_SECRET acima,
#      usando o gerador oficial do Supabase (gera os dois de uma vez):
#        https://supabase.com/docs/guides/self-hosting/docker#securing-your-services
#      ou localmente, com o script `scripts/generate-jwt-keys.md` deste
#      diretório (instruções passo a passo, sem dependência nova no repo).
#   3. Nunca reaproveitar os valores do projeto cloud — são chaves de um
#      Postgres diferente.
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

# ─── URLs públicas ──────────────────────────────────────────────────────
# API_EXTERNAL_URL: URL pública da API (atrás do proxy TLS — Fase 1).
# SITE_URL: URL do frontend (Vercel, produção) — usada pelo GoTrue para
#   montar links de confirmação/Magic Link.
# ADDITIONAL_REDIRECT_URLS: lista separada por vírgula de URLs de callback
#   permitidas além de SITE_URL (ex.: previews da Vercel, localhost em dev).
API_EXTERNAL_URL=https://api.upixel.com.br
SITE_URL=https://upixel.app
ADDITIONAL_REDIRECT_URLS=

# ─── Kong / gateway ─────────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# ─── Realtime ────────────────────────────────────────────────────────────
# Gerar com: openssl rand -base64 32  (cada um dos dois, valores distintos)
REALTIME_DB_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

# ─── Studio ──────────────────────────────────────────────────────────────
STUDIO_ORG_NAME=uPixel
STUDIO_PROJECT_NAME=uPixel CRM

# ─── SMTP (GoTrue / Magic Link — ver docs/MAGIC_LINK_SETUP.md) ──────────
# Sem isso configurado com um provedor real, Magic Link e recuperação de
# senha NÃO saem (Fase 1 do plano depende disso para aceite).
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=uPixel CRM

# ════════════════════════════════════════════════════════════════════════
# Secrets de Edge Functions (Fase 4 do plano) — inventariados na Fase 0
# a partir de `Deno.env.get(...)` em supabase/functions/*/index.ts.
# São usados pelo container `functions` (edge-runtime) — hoje o
# docker-compose.yml deste diretório só passa SUPABASE_URL/ANON_KEY/
# SERVICE_ROLE_KEY para ele; os secrets abaixo precisam ser adicionados ao
# environment do serviço `functions` no docker-compose.yml (ou via um
# arquivo de secrets do Docker) quando a Fase 4 for executada — valores
# atuais só existem no painel do Supabase cloud (Edge Functions → Secrets),
# quem tem que exportá-los de lá é o [OPERADOR].
# ════════════════════════════════════════════════════════════════════════

# Asaas (pagamentos) — usado por: asaas-payment, asaas-webhook
ASAAS_API_KEY=
ASAAS_API_URL=
ASAAS_WEBHOOK_TOKEN=

# Meta / Facebook / Instagram / WhatsApp Cloud — usado por: facebook-*,
# instagram-*, meta-ads*, whatsapp-cloud-*, data-deletion-callback
FACEBOOK_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_FB_PAGE_EMBEDDED_SIGNUP_CONFIG_ID=

# Google Ads / OAuth — usado por: google-ads, google-oauth
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq (IA) — usado por: ai-chat, rag-embed, rag-search
GROQ_API_KEY=

# Domínio raiz / provisionamento de tenant — usado por: tenant-provision-domain
ROOT_DOMAIN=upixel.app

# SDR piloto — usado por: whatsapp-webhook
SDR_PILOT_TENANT_ID=

# Evolution API (WhatsApp) — usado por: whatsapp-proxy
UPIXEL_EVOLUTION_KEY=
UPIXEL_EVOLUTION_URL=

# Web Push (VAPID) — usado por: send-push
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# Vercel API (provisionamento de domínio de tenant) — usado por: tenant-provision-domain
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
